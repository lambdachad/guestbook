{
    "name": "guestbook",
    "version": "0.1.0",
    "type": "module",
    "scripts": {
        "dev": "bun --bun vite dev",
        "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
        "format": "prettier --write .",
        "db:generate": "drizzle-kit generate",
        "build": "TARGET=server bun --bun vite build",
        "preview": "TARGET=server bun --bun vite preview",
        "android:dev": "TARGET=client cap run android -l --host localhost --port 5173 --forwardPorts 5173:5173",
        "android:build": "TARGET=client bun --bun vite build && cap sync android && cap build android"
    },
    "dependencies": {
        "@capacitor/android": "^8.5.2",
        "@capacitor/core": "^8.5.2",
        "drizzle-orm": "^1.0.0-rc.5"
    },
    "devDependencies": {
        "@capacitor/cli": "^8.5.2",
        "@sveltejs/adapter-bun": "^1.0.0-next.2",
        "@sveltejs/adapter-static": "^4.0.0-next.4",
        "@sveltejs/kit": "^3.0.0-next.27",
        "@sveltejs/vite-plugin-svelte": "^7.3.0",
        "bun-types": "^1.4.2",
        "drizzle-kit": "^1.0.0-rc.5",
        "prettier": "^3.9.8",
        "prettier-plugin-svelte": "^4.1.1",
        "svelte": "^5.57.0",
        "svelte-check": "^4.7.6",
        "typescript": "^6.0.3",
        "vite": "^8.3.0"
    },
    "prettier": {
        "printWidth": 160,
        "semi": false,
        "singleQuote": false,
        "tabWidth": 4,
        "useTabs": false,
        "trailingComma": "all",
        "plugins": [
            "prettier-plugin-svelte"
        ],
        "overrides": [
            {
                "files": "*.svelte",
                "options": {
                    "parser": "svelte"
                }
            }
        ]
    }
}
